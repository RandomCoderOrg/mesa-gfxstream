#!/usr/bin/env bash
set -euo pipefail

usage()
{
    cat >&2 <<'EOF'
Usage: udroid-gpu-run [--profile PROFILE] -- COMMAND [ARG...]

Profiles:
  vendor-vulkan:ginkage-ahb          AHardwareBuffer X11 WSI
  vendor-vulkan:ginkage-dmabuf-copy  DMA-BUF server-copy fallback
  vendor-vulkan:ginkage-dmabuf-zero  experimental direct Present
  vendor-vulkan:shm                   compatibility fallback
  system                              distribution graphics unchanged
EOF
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
runtime_root=${UDROID_GRAPHICS_ROOT:-$(CDPATH='' cd -- "$script_dir/.." && pwd)}
profile=vendor-vulkan:ginkage-ahb

while (($#)); do
    case "$1" in
        --profile)
            (($# >= 2)) || { usage; exit 2; }
            profile=$2
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

(($#)) || { usage; exit 2; }

if [[ $profile == system ]]; then
    export UDROID_RESOLVED_RENDERER=system
    export UDROID_RESOLVED_WSI=system
    exec "$@"
fi

case "$profile" in
    vendor-vulkan:ginkage-ahb)
        export WSI_X11_AHB=1
        export WSI_X11_PRIVATE_CONNECTION=1
        unset WSI_X11_DRI3_COPY WSI_X11_FORCE_SHM
        resolved_wsi=ginkage-ahb
        ;;
    vendor-vulkan:ginkage-dmabuf-copy)
        export WSI_X11_DRI3_COPY=1
        unset WSI_X11_AHB WSI_X11_PRIVATE_CONNECTION WSI_X11_FORCE_SHM
        resolved_wsi=ginkage-dmabuf-copy
        ;;
    vendor-vulkan:ginkage-dmabuf-zero)
        unset WSI_X11_AHB WSI_X11_PRIVATE_CONNECTION WSI_X11_DRI3_COPY WSI_X11_FORCE_SHM
        resolved_wsi=ginkage-dmabuf-zero
        ;;
    vendor-vulkan:shm)
        export WSI_X11_FORCE_SHM=1
        unset WSI_X11_AHB WSI_X11_PRIVATE_CONNECTION WSI_X11_DRI3_COPY
        resolved_wsi=shm
        ;;
    *)
        printf 'udroid-gpu-run: unknown profile: %s\n' "$profile" >&2
        exit 2
        ;;
esac

mesa_dir=$runtime_root/lib/mesa
bridge_dir=$runtime_root/lib/bridge
linker_dir=$bridge_dir/libhybris/linker
layer_dir=$runtime_root/share/vulkan/explicit_layer.d
icd=$runtime_root/share/vulkan/icd.d/sysvk.json

for required in \
    "$mesa_dir/dri/zink_dri.so" \
    "$bridge_dir/libhybris-common.so.1" \
    "$linker_dir/q.so" \
    "$icd" \
    "$layer_dir/VkLayer_window_system_integration.json"; do
    [[ -e $required ]] || {
        printf 'udroid-gpu-run: incomplete runtime, missing %s\n' "$required" >&2
        exit 3
    }
done

# The patched embedded linker must know the root Android TLS owner before the
# application reaches main(). Prefer an explicit path from device
# qualification, then Android's own hardware properties, and only then the
# unambiguous-single-HAL fallback used by the first Exynos proof.
android_property()
{
    local key=$1 getter value
    for getter in getprop /system/bin/getprop; do
        if [[ $getter != */* ]] && ! command -v "$getter" >/dev/null 2>&1; then
            continue
        fi
        [[ $getter != */* || -x $getter ]] || continue
        value=$($getter "$key" 2>/dev/null || true)
        if [[ $value =~ ^[A-Za-z0-9._-]+$ ]]; then
            printf '%s\n' "$value"
            return 0
        fi
    done
    return 1
}

hal_source=explicit
if [[ -n ${HYBRIS_TLS_PRELOAD:-} && -z ${UDROID_VULKAN_HAL:-} ]]; then
    export UDROID_VULKAN_HAL=$HYBRIS_TLS_PRELOAD
    hal_source=tls-preload
fi

if [[ -z ${UDROID_VULKAN_HAL:-} ]]; then
    hal_source=
    for property_name in \
        ro.hardware.vulkan \
        ro.board.platform \
        ro.hardware \
        ro.product.board; do
        property_value=$(android_property "$property_name" || true)
        [[ -n $property_value ]] || continue
        for candidate in \
            "/vendor/lib64/hw/vulkan.$property_value.so" \
            "/odm/lib64/hw/vulkan.$property_value.so" \
            "/system/lib64/hw/vulkan.$property_value.so"; do
            if [[ -r $candidate ]]; then
                export UDROID_VULKAN_HAL=$candidate
                hal_source=android-property:$property_name
                break 2
            fi
        done
    done
fi

if [[ -z ${UDROID_VULKAN_HAL:-} ]]; then
    vulkan_hals=()
    for candidate in \
        /vendor/lib64/hw/vulkan.*.so \
        /odm/lib64/hw/vulkan.*.so \
        /system/lib64/hw/vulkan.*.so; do
        [[ -r $candidate ]] || continue
        vulkan_hals+=("$candidate")
    done
    if ((${#vulkan_hals[@]} == 1)); then
        export UDROID_VULKAN_HAL=${vulkan_hals[0]}
        hal_source=single-readable-hal
    elif ((${#vulkan_hals[@]} > 1)); then
        printf 'udroid-gpu-run: multiple Vulkan HALs found; set UDROID_VULKAN_HAL to the qualified module\n' >&2
        exit 4
    fi
fi

[[ -n ${UDROID_VULKAN_HAL:-} ]] || {
    printf 'udroid-gpu-run: no Vulkan HAL found; device qualification must select one\n' >&2
    exit 4
}
if [[ -n ${HYBRIS_TLS_PRELOAD:-} && $HYBRIS_TLS_PRELOAD != "$UDROID_VULKAN_HAL" ]]; then
    printf 'udroid-gpu-run: HYBRIS_TLS_PRELOAD and UDROID_VULKAN_HAL disagree\n' >&2
    exit 4
fi
export HYBRIS_TLS_PRELOAD=$UDROID_VULKAN_HAL

export UDROID_GRAPHICS_ROOT=$runtime_root
export UDROID_RESOLVED_RENDERER=vendor-vulkan
export UDROID_RESOLVED_WSI=$resolved_wsi
export LIBGL_DRIVERS_PATH=$mesa_dir/dri
export LIBGL_KOPPER_DRI2=1
export MESA_LOADER_DRIVER_OVERRIDE=zink
export LD_LIBRARY_PATH=$mesa_dir:$bridge_dir:$layer_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

hybris_common=$bridge_dir/libhybris-common.so.1
ahb_wrapper=$bridge_dir/libahb-wrapper.so
preload_tail=
preload_input=${LD_PRELOAD:-}
preload_input=${preload_input// /:}
if [[ -n $preload_input ]]; then
    IFS=: read -r -a preload_entries <<< "$preload_input"
    for preload_entry in "${preload_entries[@]}"; do
        [[ -n $preload_entry ]] || continue
        case "$preload_entry" in
            "$hybris_common"|"$ahb_wrapper") continue ;;
        esac
        preload_tail+=:${preload_entry}
    done
fi
export LD_PRELOAD=$hybris_common:$ahb_wrapper$preload_tail

export HYBRIS_FORCE_LEGACY_PROPERTY_HOOKS=1
export HYBRIS_SKIP_BIONIC_PROPERTY_INIT=1
export HYBRIS_LINKER_DIR=$linker_dir
export HYBRIS_PTHREAD_RAW_EXIT=1
export HYBRIS_LD_LIBRARY_PATH=$bridge_dir/bionic:/system/lib64:/system_ext/lib64:/product/lib64:/vendor/lib64:/vendor/lib64/egl:/vendor/lib64/hw:/odm/lib64:/apex/com.android.runtime/lib64/bionic:/apex/com.android.i18n/lib64:/apex/com.android.tethering/lib64

export ANDROID_ROOT=/system
export ANDROID_DATA=/data
export ANDROID_RUNTIME_ROOT=
export ANDROID_ART_ROOT=/apex/com.android.art
export ANDROID_I18N_ROOT=/apex/com.android.i18n
export ANDROID_TZDATA_ROOT=/apex/com.android.tzdata

export VK_DRIVER_FILES=$icd
export VK_ICD_FILENAMES=$icd
export VK_LAYER_PATH=$layer_dir
export VK_INSTANCE_LAYERS=VK_LAYER_window_system_integration
export VK_LOADER_DEBUG=${VK_LOADER_DEBUG:-warn,error}
export WSI_ALLOW_NON_FIFO_PRESENT_MODE=${WSI_ALLOW_NON_FIFO_PRESENT_MODE:-1}

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/udroid-graphics-runtime}
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

if [[ ${UDROID_GPU_TRACE:-0} == 1 ]]; then
    printf 'udroid-gpu-run: runtime=%s renderer=%s wsi=%s hal=%s hal-source=%s\n' \
        "$runtime_root" "$UDROID_RESOLVED_RENDERER" "$UDROID_RESOLVED_WSI" \
        "$UDROID_VULKAN_HAL" "$hal_source" >&2
fi
exec "$@"
