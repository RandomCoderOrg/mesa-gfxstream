 #define X11_SWAPCHAIN_MAX_PENDING_COMPLETIONS 128
 
+static constexpr int AHB_HANDSHAKE_TIMEOUT_MS = 3000;
+
+static bool wait_for_socket_event(int fd, short events)
+{
+   pollfd descriptor = { fd, events, 0 };
+   int result;
+   do
+   {
+      result = poll(&descriptor, 1, AHB_HANDSHAKE_TIMEOUT_MS);
+   } while (result < 0 && errno == EINTR);
+
+   /* POLLIN and POLLHUP may arrive together when the peer writes its final
+    * protocol message and closes. Consume the requested event; the following
+    * read/recv validates whether data or only EOF remains. */
+   return result == 1 && (descriptor.revents & events) != 0 &&
+          (descriptor.revents & (POLLERR | POLLNVAL)) == 0;
+}
