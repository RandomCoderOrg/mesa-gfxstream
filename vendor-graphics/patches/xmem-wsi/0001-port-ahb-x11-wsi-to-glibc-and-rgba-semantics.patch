From: uDroid graphics runtime
Subject: [PATCH] X11 WSI: support glibc builds and explicit RGBA semantics

Make Android headers an explicit build input rather than linking libandroid,
fix portable C++ initialization/includes, and use an RGBA AHardwareBuffer on
devices which reject BGRA allocation. Private DRI3 modifier 1257 tells the
paired Termux:X11 server that the buffer content is already RGBA.
---
 CMakeLists.txt                 |  8 +++++++-
 util/custom_allocator.hpp      |  1 +
 wsi/x11/surface_properties.cpp |  2 +-
 wsi/x11/swapchain.cpp          | 15 ++++++++++++++-
 wsi/x11/swapchain.hpp          | 10 +++++++++-
 5 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 96af204..3149dad 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -240,6 +240,11 @@ else()
 endif()
 
 # X11 WSI
+set(ANDROID_HEADERS_INCLUDE_DIR "" CACHE PATH
+   "Parent include directory containing android/hardware_buffer.h")
+if(BUILD_WSI_X11 AND ANDROID_HEADERS_INCLUDE_DIR STREQUAL "")
+   message(FATAL_ERROR "ANDROID_HEADERS_INCLUDE_DIR is required for X11 AHardwareBuffer WSI")
+endif()
 if(BUILD_WSI_X11)
    set(CMAKE_BUILD_TYPE "Debug")
 
@@ -250,11 +255,12 @@ if(BUILD_WSI_X11)
 
    target_include_directories(wsi_x11 PRIVATE
       ${PROJECT_SOURCE_DIR}
+      ${ANDROID_HEADERS_INCLUDE_DIR}
       ${VULKAN_CXX_INCLUDE}
       ${CMAKE_CURRENT_BINARY_DIR})
 
    target_compile_options(wsi_x11 INTERFACE "-DBUILD_WSI_X11=1")
-   list(APPEND LINK_WSI_LIBS wsi_x11 xcb xcb-present xcb-xfixes xcb-dri3 X11-xcb android)
+   list(APPEND LINK_WSI_LIBS wsi_x11 xcb xcb-present xcb-xfixes xcb-dri3 X11-xcb)
 else()
    list(APPEND JSON_COMMANDS COMMAND sed -i '/VK_KHR_xcb_surface/d' ${CMAKE_CURRENT_BINARY_DIR}/VkLayer_window_system_integration.json)
    list(APPEND JSON_COMMANDS COMMAND sed -i '/VK_KHR_xlib_surface/d' ${CMAKE_CURRENT_BINARY_DIR}/VkLayer_window_system_integration.json)
