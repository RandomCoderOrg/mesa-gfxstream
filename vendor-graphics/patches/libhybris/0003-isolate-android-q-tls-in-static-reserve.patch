+
 void linker_finalize_static_tls() {
+  if (g_static_tls_finished) {
+    return;
+  }
+  if (!g_static_tls_started) {
+    linker_prepare_embedded_static_tls();
+  }
   g_static_tls_finished = true;
-  __libc_shared_globals()->static_tls_layout.finish_layout();
+  StaticTlsLayout& layout = __libc_shared_globals()->static_tls_layout;
+  layout.finish_layout();
+  if (layout.size() > hybris_tls_reserve_capacity()) {
