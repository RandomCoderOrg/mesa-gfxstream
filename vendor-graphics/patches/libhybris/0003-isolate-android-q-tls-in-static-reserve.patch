 // The address of an unresolved weak TLS symbol evaluates to NULL with TLSDESC.
 // The value returned by this function is added to the thread pointer, so return
diff --git a/hybris/common/tls_reserve.c b/hybris/common/tls_reserve.c
new file mode 100644
index 0000000..016fb41
--- /dev/null
+++ b/hybris/common/tls_reserve.c
@@ -0,0 +1,120 @@
+#define _GNU_SOURCE
+
+#include "tls_reserve.h"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define HYBRIS_TLS_RESERVE_CAPACITY (64U * 1024U)
+#define HYBRIS_TLS_METADATA_SIZE sizeof(uint64_t)
+
+static __thread unsigned char g_hybris_tls_reserve[HYBRIS_TLS_RESERVE_CAPACITY]
+    __attribute__((aligned(4096), tls_model("initial-exec")));
+static hybris_tls_initializer_t g_hybris_tls_initializer;
+static uint64_t g_hybris_tls_generation;
+
+static uint64_t* initialized_generation_slot(void) {
+  return (uint64_t*)(g_hybris_tls_reserve + HYBRIS_TLS_RESERVE_CAPACITY -
+                     HYBRIS_TLS_METADATA_SIZE);
+}
+
+void* hybris_tls_reserve_current(void) {
+  return g_hybris_tls_reserve;
+}
+
+size_t hybris_tls_reserve_capacity(void) {
+  return sizeof(g_hybris_tls_reserve) - HYBRIS_TLS_METADATA_SIZE;
+}
+
+intptr_t hybris_tls_reserve_tp_offset(void) {
+  void* thread_pointer;
+  __asm__("mrs %0, tpidr_el0" : "=r"(thread_pointer));
+  return (char*)g_hybris_tls_reserve - (char*)thread_pointer;
+}
+
+void hybris_tls_set_initializer(hybris_tls_initializer_t initializer) {
+  __atomic_store_n(&g_hybris_tls_initializer, initializer, __ATOMIC_RELEASE);
+  __atomic_add_fetch(&g_hybris_tls_generation, 1, __ATOMIC_RELEASE);
+}
+
+void hybris_tls_initialize_current_thread(void) {
+  const uint64_t generation =
+      __atomic_load_n(&g_hybris_tls_generation, __ATOMIC_ACQUIRE);
+  hybris_tls_initializer_t initializer =
+      __atomic_load_n(&g_hybris_tls_initializer, __ATOMIC_ACQUIRE);
+  uint64_t* initialized_generation = initialized_generation_slot();
+  if (initializer == NULL || *initialized_generation == generation)
+    return;
+
+  /* Prevent recursion while the linker installs this thread's Bionic state. */
+  *initialized_generation = generation;
+  initializer();
+}
+
+int hybris_tls_current_thread_initialized(void) {
+  const uint64_t generation =
+      __atomic_load_n(&g_hybris_tls_generation, __ATOMIC_ACQUIRE);
+  return generation != 0 &&
+         *initialized_generation_slot() == generation;
+}
+
+struct hybris_host_pthread_start {
+  void *(*start_routine)(void *);
+  void *arg;
+};
+
+typedef int (*host_pthread_create_t)(pthread_t *, const pthread_attr_t *,
+                                     void *(*)(void *), void *);
+
+static host_pthread_create_t get_host_pthread_create(void) {
+  static host_pthread_create_t function;
+  host_pthread_create_t resolved =
+      __atomic_load_n(&function, __ATOMIC_ACQUIRE);
+  if (resolved != NULL)
+    return resolved;
+
+  resolved = (host_pthread_create_t)dlsym(RTLD_NEXT, "pthread_create");
+  if (resolved != NULL)
+    __atomic_store_n(&function, resolved, __ATOMIC_RELEASE);
+  return resolved;
+}
+
+static void *hybris_host_pthread_start(void *opaque) {
+  struct hybris_host_pthread_start *start = opaque;
+  void *(*start_routine)(void *) = start->start_routine;
+  void *arg = start->arg;
+  free(start);
+
+  hybris_tls_initialize_current_thread();
+  return start_routine(arg);
+}
+
+/*
+ * libhybris-common is intentionally preloaded by isolated-TLS launchers. Keep
+ * Linux-created worker threads on the same Android TLS contract as the main
+ * thread and threads created by Android libraries.
+ */
+int pthread_create(pthread_t *thread, const pthread_attr_t *attr,
+                   void *(*start_routine)(void *), void *arg) {
+  host_pthread_create_t real_pthread_create = get_host_pthread_create();
+  struct hybris_host_pthread_start *start;
+  int result;
+
+  if (real_pthread_create == NULL)
+    return ENOSYS;
+
+  start = malloc(sizeof(*start));
+  if (start == NULL)
+    return ENOMEM;
+  start->start_routine = start_routine;
+  start->arg = arg;
+
+  result = real_pthread_create(thread, attr, hybris_host_pthread_start, start);
+  if (result != 0)
+    free(start);
+  return result;
+}
