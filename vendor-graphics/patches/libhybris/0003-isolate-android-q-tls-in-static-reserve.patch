+static void __attribute__((constructor)) hybris_preload_android_tls_root(void)
+{
+    const char *library;
+    void *handle;
+
+    if (getauxval(AT_SECURE))
+        return;
+    library = getenv("HYBRIS_TLS_PRELOAD");
+    if (library == NULL || library[0] == '\0')
+        return;
+
+    handle = android_dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (handle == NULL) {
+        fprintf(stderr, "libhybris: TLS preload failed for %s: %s\n",
+                library, android_dlerror());
+    }
+}
+
