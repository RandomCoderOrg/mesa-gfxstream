 __LIBC_HIDDEN__ _Atomic(size_t) __libc_tls_generation_copy = {SIZE_MAX};
 
 static bool g_static_tls_finished;
+static bool g_static_tls_started;
 static std::vector<TlsModule> g_tls_modules;
 
+struct HybrisTlsThreadState {
+  void* static_tls;
+  TlsDtv* bootstrap_dtv;
+  bionic_tcb* tcb;
+};
+
+static pthread_key_t g_hybris_tls_key;
+static pthread_once_t g_hybris_tls_key_once = PTHREAD_ONCE_INIT;
+
+static void destroy_hybris_tls_state(void* opaque) {
+  HybrisTlsThreadState* state = static_cast<HybrisTlsThreadState*>(opaque);
+  if (state == nullptr) {
+    return;
+  }
+
+  if (state->tcb != nullptr && state->tcb->tls_slot(TLS_SLOT_DTV) != nullptr) {
+    __free_dynamic_tls(state->tcb);
+  }
+  free(state->bootstrap_dtv);
+  free(state);
+}
+
+static void make_hybris_tls_key() {
+  if (pthread_key_create(&g_hybris_tls_key, destroy_hybris_tls_state) != 0) {
+    abort();
+  }
+}
+
+static HybrisTlsThreadState* get_hybris_tls_state() {
+  if (!g_static_tls_finished) {
+    abort();
+  }
+
+  if (pthread_once(&g_hybris_tls_key_once, make_hybris_tls_key) != 0) {
+    abort();
+  }
+
+  HybrisTlsThreadState* state =
+      static_cast<HybrisTlsThreadState*>(pthread_getspecific(g_hybris_tls_key));
+  if (state != nullptr) {
+    return state;
+  }
+
+  state = static_cast<HybrisTlsThreadState*>(calloc(1, sizeof(*state)));
+  if (state == nullptr) {
+    abort();
+  }
+
+  const StaticTlsLayout& layout = __libc_shared_globals()->static_tls_layout;
+  state->static_tls = hybris_tls_reserve_current();
+  memset(state->static_tls, 0, layout.size());
+
+  state->bootstrap_dtv = static_cast<TlsDtv*>(calloc(1, sizeof(TlsDtv)));
+  if (state->bootstrap_dtv == nullptr) {
+    destroy_hybris_tls_state(state);
+    abort();
+  }
+
+  __init_static_tls(state->static_tls);
+  state->tcb = reinterpret_cast<bionic_tcb*>(
+      static_cast<char*>(state->static_tls) + layout.offset_bionic_tcb());
+  __set_tcb_dtv(state->tcb, state->bootstrap_dtv);
+  if (layout.offset_bionic_tls() != SIZE_MAX) {
+    state->tcb->tls_slot(TLS_SLOT_BIONIC_TLS) =
+        static_cast<char*>(state->static_tls) + layout.offset_bionic_tls();
+  }
+
+  if (pthread_setspecific(g_hybris_tls_key, state) != 0) {
+    destroy_hybris_tls_state(state);
+    abort();
+  }
+  return state;
+}
+
+extern "C" bionic_tcb* __hybris_get_bionic_tcb() {
+  return get_hybris_tls_state()->tcb;
+}
+
+extern "C" void __hybris_tls_initialize_current_thread() {
+  get_hybris_tls_state();
+}
+
+extern "C" void* __hybris_tls_resolve_dynamic(const TlsDynamicResolverArg* arg) {
+  return __hybris_tls_get_addr(&arg->index);
+}
