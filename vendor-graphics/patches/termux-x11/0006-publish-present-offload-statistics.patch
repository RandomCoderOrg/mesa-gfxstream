From: uDroid graphics runtime
Subject: [PATCH] lorie: publish Present offload statistics

Expose low-frequency cumulative Present-copy counters on the X root window so
an unprivileged guest can verify that AHardwareBuffer frames are actually GPU
offloaded. Keep the counters off the per-frame property path and classify every
attempt as exactly one success or fallback reason.
---
diff --git a/lorie/src/main/cpp/lorie/InitOutput.c b/lorie/src/main/cpp/lorie/InitOutput.c
--- a/lorie/src/main/cpp/lorie/InitOutput.c
+++ b/lorie/src/main/cpp/lorie/InitOutput.c
@@ -118,6 +118,7 @@
 static char *xstartup = NULL;
 
 #define UDROID_X11_BUFFER_TRANSPORT_ATOM "_UDROID_X11_BUFFER_TRANSPORT"
+#define UDROID_X11_PRESENT_STATS_ATOM "_UDROID_X11_PRESENT_STATS"
 
 enum {
     UDROID_X11_TRANSPORT_AHB_SOCKET = 1U << 0,
@@ -125,7 +126,45 @@
     UDROID_X11_TRANSPORT_SYNC_FILE_ACQUIRE = 1U << 2,
     UDROID_X11_TRANSPORT_GPU_COPY = 1U << 3,
 };
+
+typedef struct {
+    uint64_t attempts;
+    uint64_t offloads;
+    uint64_t disabled;
+    uint64_t rendererUnavailable;
+    uint64_t bufferUnsupported;
+    uint64_t regionUnsupported;
+    uint64_t queueFull;
+} LoriePresentStats;
+
+static LoriePresentStats presentStats;
+
+static void loriePublishPresentStats(ScreenPtr pScreen) {
+    const CARD32 stats[] = {
+        1,
+        (CARD32) presentStats.attempts, (CARD32) (presentStats.attempts >> 32),
+        (CARD32) presentStats.offloads, (CARD32) (presentStats.offloads >> 32),
+        (CARD32) presentStats.disabled, (CARD32) (presentStats.disabled >> 32),
+        (CARD32) presentStats.rendererUnavailable, (CARD32) (presentStats.rendererUnavailable >> 32),
+        (CARD32) presentStats.bufferUnsupported, (CARD32) (presentStats.bufferUnsupported >> 32),
+        (CARD32) presentStats.regionUnsupported, (CARD32) (presentStats.regionUnsupported >> 32),
+        (CARD32) presentStats.queueFull, (CARD32) (presentStats.queueFull >> 32),
+    };
+    Atom property = MakeAtom(UDROID_X11_PRESENT_STATS_ATOM,
+                             strlen(UDROID_X11_PRESENT_STATS_ATOM), TRUE);
 
+    if (property == BAD_RESOURCE ||
+        dixChangeWindowProperty(serverClient, pScreen->root, property,
+                                XA_CARDINAL, 32, PropModeReplace,
+                                sizeof(stats) / sizeof(stats[0]),
+                                stats, FALSE) != Success)
+        log(ERROR, "Failed to publish uDroid X11 Present statistics");
+    else if (presentStats.attempts)
+        log(INFO, "Published uDroid X11 Present statistics: %llu/%llu offloaded",
+            (unsigned long long) presentStats.offloads,
+            (unsigned long long) presentStats.attempts);
+}
+
 static void loriePublishBufferTransportCapabilities(unused CallbackListPtr *callbacks,
                                                     unused void *closure, void *data) {
     ScreenPtr pScreen = data;
@@ -147,6 +186,8 @@
                                 sizeof(protocol) / sizeof(protocol[0]),
                                 protocol, FALSE) != Success)
         log(ERROR, "Failed to publish uDroid X11 buffer transport capabilities");
+
+    loriePublishPresentStats(pScreen);
 }
 
 // Owned by the activity process, handed to us over the connection socket. Points at a placeholder until
@@ -556,13 +597,51 @@
 }
 
 static uint64_t gpuCopyAttempts = 0, gpuCopyOffloads = 0;
+
+enum LorieGpuCopyResult {
+    LORIE_GPU_COPY_OFFLOADED,
+    LORIE_GPU_COPY_DISABLED,
+    LORIE_GPU_COPY_RENDERER_UNAVAILABLE,
+    LORIE_GPU_COPY_BUFFER_UNSUPPORTED,
+    LORIE_GPU_COPY_REGION_UNSUPPORTED,
+    LORIE_GPU_COPY_QUEUE_FULL,
+};
 
+static void lorieRecordGpuCopyResult(enum LorieGpuCopyResult result) {
+    gpuCopyAttempts++;
+    presentStats.attempts++;
+    switch (result) {
+    case LORIE_GPU_COPY_OFFLOADED:
+        gpuCopyOffloads++;
+        presentStats.offloads++;
+        break;
+    case LORIE_GPU_COPY_DISABLED:
+        presentStats.disabled++;
+        break;
+    case LORIE_GPU_COPY_RENDERER_UNAVAILABLE:
+        presentStats.rendererUnavailable++;
+        break;
+    case LORIE_GPU_COPY_BUFFER_UNSUPPORTED:
+        presentStats.bufferUnsupported++;
+        break;
+    case LORIE_GPU_COPY_REGION_UNSUPPORTED:
+        presentStats.regionUnsupported++;
+        break;
+    case LORIE_GPU_COPY_QUEUE_FULL:
+        presentStats.queueFull++;
+        break;
+    }
+}
+
-static CARD32 lorieFramecounter(unused OsTimerPtr timer, unused CARD32 time, unused void *arg) {
+static CARD32 lorieFramecounter(unused OsTimerPtr timer, unused CARD32 time, void *arg) {
+    ScreenPtr pScreen = arg;
     if (pvfb->state->renderedFrames || gpuCopyAttempts)
         log(INFO, gpuCopyAttempts ? "%d frames in 5.0 seconds = %.1f FPS, %llu/%llu present copies offloaded to GPU"
                                    : "%d frames in 5.0 seconds = %.1f FPS",
             pvfb->state->renderedFrames, ((float) pvfb->state->renderedFrames) / 5,
             (unsigned long long) gpuCopyOffloads, (unsigned long long) gpuCopyAttempts);
+    if (pScreen && pScreen->root)
+        loriePublishPresentStats(pScreen);
     pvfb->state->renderedFrames = 0;
     gpuCopyAttempts = gpuCopyOffloads = 0;
     return 5000;
@@ -914,19 +993,19 @@
     uint32_t writeIndex, readIndex;
 
     if (pvfb->gpuPresentDisabled || pvfb->root.legacyDrawing) {
-        gpuCopyAttempts++;
+        lorieRecordGpuCopyResult(LORIE_GPU_COPY_DISABLED);
         return FALSE;
     }
 
     if (!lorieConnectionAlive()) {
         // No renderer to drain the queue, so fall back to CPU copy.
-        gpuCopyAttempts++;
+        lorieRecordGpuCopyResult(LORIE_GPU_COPY_RENDERER_UNAVAILABLE);
         return FALSE;
     }
 
     if (!(srcBuffer = lorieEnsureGpuSampleable(pixmap, LORIEBUFFER_AHARDWAREBUFFER)) ||
         !(dstBuffer = lorieEnsureGpuSampleable(dst, LORIEBUFFER_AHARDWAREBUFFER))) {
-        gpuCopyAttempts++;
+        lorieRecordGpuCopyResult(LORIE_GPU_COPY_BUFFER_UNSUPPORTED);
         return FALSE;
     }
     priv = LORIE_PIXMAP_PRIV_FROM_PIXMAP(pixmap);
@@ -943,14 +1022,14 @@
     }
 
     if (numRects <= 0 || numRects > LORIE_GPU_COPY_MAX_RECTS) {
-        gpuCopyAttempts++;
+        lorieRecordGpuCopyResult(LORIE_GPU_COPY_REGION_UNSUPPORTED);
         return FALSE;
     }
 
     writeIndex = pvfb->state->gpuCopyQueue.writeIndex;
     readIndex = pvfb->state->gpuCopyQueue.readIndex;
     if (writeIndex - readIndex >= LORIE_GPU_COPY_QUEUE_CAPACITY) {
-        gpuCopyAttempts++;
+        lorieRecordGpuCopyResult(LORIE_GPU_COPY_QUEUE_FULL);
         return FALSE;
     }
 
@@ -985,8 +1064,7 @@
     pthread_cond_signal(rendererCond);
 
     *out_serial = entry->serial;
-    gpuCopyAttempts++;
-    gpuCopyOffloads++;
+    lorieRecordGpuCopyResult(LORIE_GPU_COPY_OFFLOADED);
     return TRUE;
 }
 
