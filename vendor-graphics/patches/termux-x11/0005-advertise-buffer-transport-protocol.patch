From: uDroid graphics runtime
Subject: [PATCH] lorie: advertise paired X11 buffer transport

Publish a versioned root-window property only after Xorg creates the root
window. The property lets paired clients discover AHardwareBuffer socket
transport, RGBA semantics, sync-file acquire fences, GPU-copy Present support,
and both private transport identifiers without misrepresenting them as DRM
modifiers.
---
diff --git a/lorie/src/main/cpp/lorie/InitOutput.c b/lorie/src/main/cpp/lorie/InitOutput.c
--- a/lorie/src/main/cpp/lorie/InitOutput.c
+++ b/lorie/src/main/cpp/lorie/InitOutput.c
@@ -38,6 +38,9 @@
 #include "drm_fourcc.h"
 
 #include "lorie.h"
+#include <X11/Xatom.h>
+#include "dix.h"
+#include "property.h"
 
 #define DRM_FORMAT_MOD_LINEAR 0
 
@@ -118,6 +121,38 @@ static lorieScreenInfo lorieScreen = {
         .vblank_queue = { &lorieScreen.vblank_queue, &lorieScreen.vblank_queue },
 }, *pvfb = &lorieScreen;
 static char *xstartup = NULL;
+
+#define UDROID_X11_BUFFER_TRANSPORT_ATOM "_UDROID_X11_BUFFER_TRANSPORT"
+
+enum {
+    UDROID_X11_TRANSPORT_AHB_SOCKET = 1U << 0,
+    UDROID_X11_TRANSPORT_AHB_RGBA = 1U << 1,
+    UDROID_X11_TRANSPORT_SYNC_FILE_ACQUIRE = 1U << 2,
+    UDROID_X11_TRANSPORT_GPU_COPY = 1U << 3,
+};
+
+static void loriePublishBufferTransportCapabilities(unused CallbackListPtr *callbacks,
+                                                    unused void *closure, void *data) {
+    ScreenPtr pScreen = data;
+    const CARD32 protocol[] = {
+        1,
+        UDROID_X11_TRANSPORT_AHB_SOCKET |
+            UDROID_X11_TRANSPORT_AHB_RGBA |
+            UDROID_X11_TRANSPORT_SYNC_FILE_ACQUIRE |
+            UDROID_X11_TRANSPORT_GPU_COPY,
+        1255, 0,
+        1257, 0,
+    };
+    Atom property = MakeAtom(UDROID_X11_BUFFER_TRANSPORT_ATOM,
+                             strlen(UDROID_X11_BUFFER_TRANSPORT_ATOM), TRUE);
+
+    if (property == BAD_RESOURCE ||
+        dixChangeWindowProperty(serverClient, pScreen->root, property,
+                                XA_CARDINAL, 32, PropModeReplace,
+                                sizeof(protocol) / sizeof(protocol[0]),
+                                protocol, FALSE) != Success)
+        log(ERROR, "Failed to publish uDroid X11 buffer transport capabilities");
+}
 
 // Owned by the activity process, handed to us over the connection socket. Points at a placeholder until
 // the first connection so callers don't need a NULL check.
@@ -749,6 +784,12 @@ static Bool lorieScreenInit(ScreenPtr pScreen, unused int argc, unused char **a
     ShmRegisterFbFuncs(pScreen);
     miSyncShmScreenInit(pScreen);
 
+    /* The callback manager is recreated on every X server generation, so this
+     * registration must be repeated with each screen initialization. */
+    if (!AddCallback(&RootWindowFinalizeCallback,
+                     loriePublishBufferTransportCapabilities, NULL))
+        return FALSE;
+
     return TRUE;
 }                               /* end lorieScreenInit */
 
-- 
