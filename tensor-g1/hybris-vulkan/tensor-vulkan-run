#!/bin/bash
set -euo pipefail

root=${TENSOR_VK_ROOT:-/root/hybris-rootless}
hybris_build="$root/src/libhybris-upstream/hybris"
sysvk="$root/src/sysvk"
backend=${TENSOR_VK_BACKEND:-ginkage}
layer_dir=
resolved_wsi=

export HYBRIS_LINKER_DIR="$hybris_build/common/q/.libs"
export HYBRIS_LD_LIBRARY_PATH=${HYBRIS_LD_LIBRARY_PATH:-'/root/hybris-rootless/android-bionic:/system/lib64:/system_ext/lib64:/product/lib64:/vendor/lib64:/vendor/lib64/egl:/vendor/lib64/hw:/odm/lib64:/apex/com.android.runtime/lib64/bionic'}
export HYBRIS_LD_DEBUG=${HYBRIS_LD_DEBUG:--1}
export HYBRIS_PTHREAD_RAW_EXIT=1
export VK_DRIVER_FILES="$sysvk/sysvk_upstream_nodelete_icd.json"
export VK_ICD_FILENAMES="$VK_DRIVER_FILES"
export DISPLAY=${DISPLAY:-:0}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/hybris-runtime}

unset VK_LAYER_PATH VK_IMPLICIT_LAYER_PATH VK_INSTANCE_LAYERS DISABLE_WSI_LAYER
unset WSI_X11_FORCE_SHM WSI_X11_DRI3_COPY

case "$backend" in
  ginkage)
    layer_dir=${TENSOR_VK_GINKAGE_LAYER_DIR:-${TENSOR_VK_LAYER_DIR:-/usr/share/vulkan/implicit_layer.d}}
    case "${TENSOR_VK_WSI_MODE:-copy}" in
      copy)
        # Best current baseline: raw DMA-BUF plus a server-side Present copy.
        export WSI_X11_DRI3_COPY=1
        resolved_wsi=ginkage-dmabuf-copy
        ;;
      zero)
        # Direct DRI3 presentation; release pacing was slower in prior tests.
        resolved_wsi=ginkage-dmabuf-zero
        ;;
      shm)
        # Compatibility escape hatch with a full GPU-to-CPU-to-X copy.
        export WSI_X11_FORCE_SHM=1
        resolved_wsi=shm
        ;;
      *)
        echo "TENSOR_VK_WSI_MODE must be copy, zero, or shm for the ginkage backend" >&2
        exit 2
        ;;
    esac
    ;;
  xmem-ahb)
    layer_dir=${TENSOR_VK_XMEM_LAYER_DIR:-$root/xmem-ahb-prefix/share/vulkan/implicit_layer.d}
    wrapper=${TENSOR_VK_AHB_WRAPPER:-$root/ahb-probe-prefix/lib/libahb-wrapper.so}
    manifest="$layer_dir/VkLayer_udroid_xmem_ahb.json"
    library="$layer_dir/libVkLayer_window_system_integration.so"
    for required in "$wrapper" "$manifest" "$library"; do
      if [ ! -f "$required" ]; then
        echo "xmem-ahb backend unavailable: missing $required" >&2
        exit 3
      fi
    done
    case "${TENSOR_VK_WSI_MODE:-ahb}" in
      ahb|auto) ;;
      *)
        echo "TENSOR_VK_WSI_MODE must be ahb or auto for the xmem-ahb backend" >&2
        exit 2
        ;;
    esac
    # Disable the installed Ginkage GLOBAL layer and explicitly enable only the
    # uniquely named xMeM oracle from its isolated directory.
    export DISABLE_WSI_LAYER=1
    export VK_LAYER_PATH="$layer_dir"
    export VK_INSTANCE_LAYERS=VK_LAYER_UDROID_xmem_ahb
    export LD_PRELOAD="$wrapper${LD_PRELOAD:+:$LD_PRELOAD}"
    resolved_wsi=xmem-ahb-oracle
    ;;
  *)
    echo "TENSOR_VK_BACKEND must be ginkage or xmem-ahb" >&2
    exit 2
    ;;
esac

export LD_LIBRARY_PATH="$sysvk:$hybris_build/hardware/.libs:$hybris_build/common/.libs:$layer_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export UDROID_RESOLVED_RENDERER=vendor-vulkan
export UDROID_RESOLVED_WSI="$resolved_wsi"

if test "${TENSOR_VK_ALLOW_NON_FIFO:-1}" = 1; then
  export WSI_ALLOW_NON_FIFO_PRESENT_MODE=1
else
  unset WSI_ALLOW_NON_FIFO_PRESENT_MODE
fi

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
if test "${TENSOR_VK_TRACE:-0}" = 1; then
  printf 'tensor-vulkan-run: renderer=%s wsi=%s layer_dir=%s\n' \
    "$UDROID_RESOLVED_RENDERER" "$UDROID_RESOLVED_WSI" "$layer_dir" >&2
fi
exec "$@"
