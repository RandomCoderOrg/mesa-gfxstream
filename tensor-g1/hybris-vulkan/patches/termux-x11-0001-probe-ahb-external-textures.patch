+__LIBC_HIDDEN__ bool LorieBuffer_bindExternalTexture(LorieBuffer *buffer) {
+    if (!buffer || buffer->desc.type != LORIEBUFFER_AHARDWAREBUFFER ||
+        !buffer->image)
+        return false;
+
+    if (!buffer->externalId) {
+        glGenTextures(1, &buffer->externalId);
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, buffer->externalId);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER,
+                        GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER,
+                        GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S,
+                        GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T,
+                        GL_CLAMP_TO_EDGE);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, buffer->image);
+        if (glGetError() != GL_NO_ERROR) {
+            glDeleteTextures(1, &buffer->externalId);
+            buffer->externalId = 0;
+            return false;
+        }
+    } else {
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, buffer->externalId);
+    }
+
+    return true;
+}
+
 __LIBC_HIDDEN__ unsigned int LorieBuffer_getGLTextureId(LorieBuffer *buffer) {
     return buffer ? buffer->id : 0;
 }
