+EXPORT int32_t my32_system(x64emu_t* emu, const char* command)
+{
+    if(!command || !emu->context->bashpath)
+        return system(command);
+
+    pid_t child = fork();
+    if(child < 0)
+        return -1;
+    if(child == 0) {
+        execl(emu->context->box64path,
+              emu->context->box64path,
+              emu->context->bashpath,
+              "-c",
+              command,
+              (char*)NULL);
+        _exit(127);
+    }
+
+    int status;
+    while(waitpid(child, &status, 0) < 0) {
+        if(errno != EINTR)
+            return -1;
+    }
+    return status;
+}
