#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
   echo "usage: $0 command [args ...]" >&2
   exit 2
fi

# Mesa now discovers the Kbase platform automatically. This wrapper selects
# only the presentation policy; set PAN_MALI_X11_DRI3=0 for the older
# CPU-upload fallback.
export PAN_MALI_X11_DRI3=${PAN_MALI_X11_DRI3:-1}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$script_dir/run-panfrost" "$@"
