#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$script_dir/../panfork/run-panfrost-x11" ]; then
   panfork_x11="$script_dir/../panfork/run-panfrost-x11"
elif [ -x "$script_dir/../run-panfrost-x11" ]; then
   panfork_x11="$script_dir/../run-panfrost-x11"
else
   echo "run-panfrost-x11 was not found next to the desktop scripts" >&2
   exit 1
fi

epiphany=${EPIPHANY_BIN:-epiphany}
if ! command -v "$epiphany" >/dev/null 2>&1; then
   echo "GNOME Web was not found at $epiphany" >&2
   exit 1
fi

export DISPLAY="${DISPLAY:-:0}"
export GDK_BACKEND=x11

# WebKitGTK's DMA-BUF renderer expects the DRM/GBM device model. This port has
# a Kbase /dev/mali0 device instead, and enabling that renderer makes Epiphany
# abort in GTK style-provider setup. The legacy renderer still uses Panfrost
# for WebKit accelerated composition and can display GStreamer video frames.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"

# WebKit's process sandbox cannot create its namespaces inside an unprivileged
# PRoot. Keep this exception scoped to this launcher.
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS="${WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS:-1}"
export NO_AT_BRIDGE="${NO_AT_BRIDGE:-1}"

export PAN_MALI_X11_DRI3="${PAN_MALI_X11_DRI3:-0}"
export PAN_MESA_DEBUG="${PAN_MESA_DEBUG:-sync}"

exec "$panfork_x11" "$epiphany" "$@"
