#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$script_dir/../panfork/run-panfrost-x11" ]; then
   panfork_x11="$script_dir/../panfork/run-panfrost-x11"
elif [ -x "$script_dir/../run-panfrost-x11" ]; then
   panfork_x11="$script_dir/../run-panfrost-x11"
else
   echo "run-panfrost-x11 was not found next to the desktop scripts" >&2
   exit 1
fi

firefox=${FIREFOX_BIN:-/opt/firefox/firefox}
if [ ! -x "$firefox" ]; then
   echo "Firefox was not found at $firefox" >&2
   exit 1
fi

profile=${FIREFOX_PROFILE:-/root/.mozilla/firefox/panfrost-profile}
mkdir -p "$profile"

# Android exposes /sys/bus/pci but PRoot has no /proc/bus/pci/devices. Firefox's
# glxtest otherwise dies inside libpci before it reaches the real GL test. The
# app-scoped stub has no libpci entry points, which glxtest treats as a warning.
glxtest_stub=${FIREFOX_GLXTEST_STUB:-/opt/firefox-glxtest-stub}
if [ -r "$glxtest_stub/libpci.so.3" ]; then
   if [ -n "${LD_LIBRARY_PATH:-}" ]; then
      export LD_LIBRARY_PATH="$glxtest_stub:$LD_LIBRARY_PATH"
   else
      export LD_LIBRARY_PATH="$glxtest_stub"
   fi
fi

export DISPLAY="${DISPLAY:-:0}"
export GDK_BACKEND=x11
export MOZ_ENABLE_WAYLAND=0
export MOZ_WEBRENDER=1

# Firefox's GLX hardware-WebRender compositor requests a 3.2 core context.
# This fork normally advertises the conservative GL 3.0 cap, but it can create
# and initialise the 3.2 context when Mesa's application-scoped override is
# used. Do not apply these overrides system-wide.
export MESA_GL_VERSION_OVERRIDE="${MESA_GL_VERSION_OVERRIDE:-3.2}"
export MESA_GLSL_VERSION_OVERRIDE="${MESA_GLSL_VERSION_OVERRIDE:-150}"

# Firefox uses X11 EGL because stock Firefox requires EGL for DMA-BUF and
# VA-API. This fork gives that swrast loader the same reusable DMA-BUF/DRI3
# Present queue as GLX, avoiding its broken CPU-upload presentation path.
export PAN_MALI_X11_DRI3="${PAN_MALI_X11_DRI3:-1}"
export PAN_MESA_DEBUG="${PAN_MESA_DEBUG:-sync}"
# AHardwareBuffer-backed display targets substantially improve Present
# throughput, but Mutter cannot yet use the same path for its own swapchain.
# Keep Firefox's experiment opt-in instead of changing the stable default.
export PAN_MALI_X11_AHB="${PAN_MALI_X11_AHB:-0}"

# Opt in to the rootless H.264 VA-API -> Android MediaCodec bridge. Firefox's
# RDD sandbox cannot open the shared Unix socket or Android DMA heap from a
# PRoot container, so this mode must disable that one subprocess sandbox. It
# does not disable the content-process sandbox or require a custom Firefox.
if [ "${TENSOR_VAAPI:-0}" = 1 ]; then
   va_drivers_path=${TENSOR_VA_DRIVERS_PATH:-/opt/tensor-va/lib/dri}
   if [ ! -r "$va_drivers_path/tensor_drv_video.so" ]; then
      echo "Tensor VA-API driver was not found in $va_drivers_path" >&2
      exit 1
   fi
   export LIBVA_DRIVER_NAME=tensor
   export LIBVA_DRIVERS_PATH="$va_drivers_path"
   # Firefox imports VA-API's R8 and GR88 planes as EGLImages. Kbase can
   # import their DMA-heap file descriptors even though /dev/mali0 is not a
   # DRM device and cannot advertise PRIME capabilities through drmGetCap().
   export MOZ_DISABLE_RDD_SANDBOX="${MOZ_DISABLE_RDD_SANDBOX:-1}"
   # Exynos holds the first H.264 output until later access units arrive, while
   # Firefox exports that VA surface immediately.  Let Firefox import the
   # preallocated DMA-BUF and fill it later when the matching PTS is returned.
   export TENSOR_VA_DEFERRED_EXPORT="${TENSOR_VA_DEFERRED_EXPORT:-1}"
   # When the native service uses Kbase release fences, allocate matching VA
   # surfaces from the uncached heap. A cached DMA_BUF_IOCTL_SYNC_START would
   # wait on the producer's own pending write fence.
   if [ "${TENSOR_VA_RELEASE_FENCE:-0}" = 1 ]; then
      export TENSOR_VA_DMA_HEAP="${TENSOR_VA_DMA_HEAP:-system-uncached}"
      # Rootless Kbase has no DRM render node through which Mesa can import
      # implicit DMA-BUF fences. Make Panfrost wait on the imported writer
      # fence before submitting a JM batch that samples the decoded planes.
      export PAN_MALI_DMABUF_SYNC_WAIT="${PAN_MALI_DMABUF_SYNC_WAIT:-1}"
   fi
fi

exec "$panfork_x11" "$firefox" --no-remote --profile "$profile" "$@"
